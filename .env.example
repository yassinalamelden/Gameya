# Gam'eya — environment template. Copy to .env and fill in.
# NEVER commit a real .env (it is git-ignored). Placeholders only here.

# --- PayPal Sandbox (server-side only; never expose the secret to the browser) ---
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# --- App / DB ---
ENV=local_test
DEMO_MODE=true
DATABASE_URL=sqlite:///./gameya.db
FRONTEND_ORIGIN=http://localhost:5173

# --- LLM providers (P2/P3) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend (Vite) ---
# build against shared/fixtures until the Fri 30 Oct 09:00 live switchover
VITE_USE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
